<resources>
    <style name="StillTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#3448CE</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="StillBlackTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#A0ADFF</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:colorBackgroundFloating">#151821</item>
    </style>
    <style name="WallpaperDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorBackgroundFloating">#CCFFFFFF</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:textColorPrimary">#141414</item>
        <item name="android:textColorSecondary">#303030</item>
        <item name="android:colorAccent">#243180</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="WallpaperDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackgroundFloating">#CC000000</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#E8E8E8</item>
        <item name="android:colorAccent">#E1E6FF</item>
    </style>
</resources>
